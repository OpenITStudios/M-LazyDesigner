# OS / editor-local state
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Local AI/client state
.blockit/
.claude/
.codex/

# Local environment / secrets
.env
.env.*
!.env.example

# Dependencies / generated runtime output
node_modules/
dist/
*.log
*.tmp
*.bak
*.orig
*.rej
nul

# Tool cache
/.cache/
__pycache__/
*.pyc
mcp/.cache/

# Obsidian UI/workspace state is local; Markdown under docs/knowledge stays tracked.
docs/knowledge/.obsidian/

# Asset Workspace transient visual/debug output. Intentional project files stay tracked.
workspace/**/.cache/
workspace/**/mcp-results.jsonl

# Experimental transient runtime/proof output. Intentional harness source stays tracked.
experiments/**/.cache/

# Repository-root generated visual/debug output is transient and must stay local.
.capture/
.sample-renders/

# Legacy local workspace cache path remains ignored if an older package is opened.
workspace/**/mcp-data/cache/


# LazyDesigner Desktop generated build/icon output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/icons/

apps/desktop/src-tauri/resources/managed/

# Native Svelte checker generated workspace
apps/desktop/.svelte-check/
