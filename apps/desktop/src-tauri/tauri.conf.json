{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyDesigner",
  "version": "0.1.1",
  "identifier": "com.halokaryamedia.lazydesigner",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "LazyDesigner",
      "width": 980,
      "height": 680,
      "minWidth": 780,
      "minHeight": 560,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "publisher": "Halo Karya Media",
    "shortDescription": "LazyDesigner desktop control plane for Blockbench integration and runtime supervision.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
