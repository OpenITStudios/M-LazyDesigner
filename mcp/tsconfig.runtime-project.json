{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": ".cache/runtime-project",
    "tsBuildInfoFile": ".cache/runtime-project.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "references": [
    {
      "path": "./tsconfig.semantic-core.json"
    },
    {
      "path": "./tsconfig.gateway-shared.json"
    }
  ],
  "include": [
    "server/**/*.ts",
    "lib/**/*.ts",
    "types.d.ts",
    "blockbench-runtime-augmentations.d.ts",
    "package.json",
    "compatibility/blockbench.json",
    "compatibility/lazydesigner-identity.ts",
    "prompts/manifest.json"
  ],
  "exclude": [
    "gateway/**",
    "plugin/**",
    "ui/**",
    "macros/**",
    "distribution/**",
    "tests/**",
    "scripts/**",
    "build/**",
    "dist/**",
    ".cache/**",
    "lib/semantic/**",
    "lib/runtime/fetch.ts",
    "lib/runtime/authorization.ts",
    "lib/runtime/connection.ts",
    "lib/runtime/affinity.ts",
    "lib/capabilities/metadata.ts",
    "lib/capabilities/manifest.ts",
    "lib/capabilities/authoringPhase.ts",
    "lib/capabilities/authoringStage.ts",
    "lib/capabilities/registrationProfile.ts"
  ]
}
