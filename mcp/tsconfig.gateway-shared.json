{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": ".cache/gateway-shared",
    "tsBuildInfoFile": ".cache/gateway-shared.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": [
      "bun", "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "lib/runtime/fetch.ts",
    "lib/runtime/authorization.ts",
    "lib/runtime/connection.ts",
    "lib/capabilities/metadata.ts",
    "lib/capabilities/manifest.ts",
    "lib/capabilities/authoringPhase.ts",
    "lib/capabilities/authoringStage.ts",
    "lib/capabilities/registrationProfile.ts",
    "lib/runtime/affinity.ts"
  ],
  "exclude": []
}
