{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "lib/semantic",
    "outDir": ".cache/semantic-core",
    "tsBuildInfoFile": ".cache/semantic-core.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": [
      "bun", "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "lib/semantic/canonical.ts",
    "lib/semantic/identity.ts",
    "lib/semantic/incremental.ts",
    "lib/semantic/knowledge.ts"
  ],
  "exclude": []
}
