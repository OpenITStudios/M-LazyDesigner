{
  "name": "lazydesigner-bedrock-entity-mcp",
  "version": "0.2.0",
  "description": "Minecraft Bedrock Entity-focused MCP server plugin for Blockbench",
  "keywords": [
    "Blockbench",
    "MCP"
  ],
  "license": "GPL-3.0-only",
  "author": "Halo Karya Media",
  "contributors": [
    "Jason J. Gardner"
  ],
  "type": "module",
  "main": "dist/lazydesigner_mcp.js",
  "scripts": {
    "check": "bun run verify:repository && bun run typecheck && bun run typecheck:gateway",
    "verify": "bun run verify:full",
    "benchmark": "bun run verify:benchmarks",
    "release": "bun run verify:release",
    "typecheck": "tsc --noEmit",
    "typecheck:gateway": "tsc -p gateway/tsconfig.json --noEmit",
    "typecheck:profile": "tsc --noEmit --extendedDiagnostics",
    "test": "bun test",
    "verify:texture:focused": "bun test tests/texture-seam-continuity.test.ts tests/texture-geometry-signal-compiler.test.ts tests/texture-masks.test.ts tests/texture-treatment-intelligence.test.ts && bun run typecheck",
    "test:runtime": "bun test tests/*.test.ts tests/benchmark/*.test.ts tests/contracts/*.test.ts tests/development/*.test.ts tests/live/*.test.ts tests/runtime/*.test.ts --path-ignore-patterns '**/managed-install.test.ts' && bun test tests/managed-install.test.ts",
    "gateway": "bun run ./gateway/index.ts",
    "setup:tls": "bun run ./scripts/operations/setup-runtime-tls.ts",
    "measure:surface": "bun run ./scripts/measure/measure-default-surface.ts",
    "measure:stages": "bun run ./scripts/measure/measure-stage-surfaces.ts",
    "measure:control": "bun run ./scripts/measure/measure-control-context.ts",
    "measure:astra-context": "bun run ./scripts/measure/measure-astra-context.ts",
    "measure:model-context": "bun run ./scripts/measure/measure-model-context-footprint.ts",
    "measure:continuation": "bun run ./scripts/measure/measure-continuation-checkpoint.ts",
    "generate:development-symbol-map": "bun run ./scripts/development/build-development-symbol-map.ts",
    "benchmark:zero-waste": "bun run ./scripts/benchmark/benchmark-zero-waste-golden.ts",
    "benchmark:zero-waste-workflow": "bun run ./scripts/benchmark/benchmark-zero-waste-workflow.ts",
    "benchmark:zero-waste-bottlenecks": "bun run ./scripts/benchmark/benchmark-zero-waste-bottlenecks.ts",
    "benchmark:zero-waste-total": "bun run ./scripts/benchmark/benchmark-zero-waste-total-context.ts",
    "eval:quality-benchmark": "bun test tests/benchmark/quality-benchmark-contract.test.ts",
    "eval:astra-usage": "bun run ./scripts/evaluate/validate-astra-usage.ts",
    "eval:session-policy": "bun run ./scripts/evaluate/evaluate-codex-session-policy.ts",
    "verify:astra-usage-ready": "bun run ./scripts/verify/verify-astra-usage-ready.ts",
    "eval:call-efficiency": "bun test tests/tool-call-efficiency-contract.test.ts",
    "verify:repository": "bun test tests/repository/*.test.ts",
    "verify:authoring": "bun test tests/authoring/*.test.ts",
    "verify:fixture-static": "bun test tests/authoring/current-workspace-fixture-static.test.ts",
    "verify:closure": "bun run verify:repository && bun run verify:authoring && bun run docs:check",
    "verify:mcp": "bun run verify:types && bun run verify:contracts && bun run verify:benchmarks && bun run verify:surface-guards && bun run build",
    "verify:full": "bun run verify:repository && bun run verify:mcp",
    "verify:release": "bun run security:audit && bun run verify:full",
    "eval:tool-discovery": "bun run ./scripts/evaluate/evaluate-tool-discovery.ts",
    "verify:stateless-local": "bun run ./scripts/verify/verify-stateless-local.ts",
    "verify:geometry-live": "bun run ./scripts/verify/verify-geometry-live.ts",
    "verify:surface-gap-live": "bun run ./scripts/verify/verify-surface-gap-live.ts",
    "verify:texturing-live": "bun run ./scripts/verify/verify-texturing-live.ts",
    "verify:animation-live": "bun run ./scripts/verify/verify-animation-live.ts",
    "verify:particle-live": "bun run ./scripts/verify/verify-particle-live.ts",
    "verify:persistence-live": "bun run ./scripts/verify/verify-persistence-live.ts",
    "verify:project-affinity-live": "bun run ./scripts/verify/verify-project-affinity-live.ts",
    "deploy:local": "bun run build && bun run ./scripts/operations/deploy-local.ts",
    "deploy:verified": "bun run ./scripts/operations/verified-build-artifact.ts deploy",
    "prompts:build": "bun run ./build/generate-manifest.ts",
    "dev": "bun run prompts:build && bun run ./build --sourcemap",
    "dev:watch": "bun run prompts:build && bun run ./build --sourcemap --watch",
    "dev:sync": "bun run ./scripts/operations/dev-sync.ts",
    "build": "bun run prompts:build && bun run ./build --minify",
    "docs:build": "bun run ./scripts/generate/generate-docs.ts",
    "generate:owned-artifacts": "bun run docs:build && bun run prompts:build && bun run generate:hybrid4-schemas",
    "docs:check": "bun run ./scripts/verify/verify-generated-artifacts-fresh.ts",
    "docs:serve": "bun run docs/index.html",
    "docs": "bun run prompts:build && bun run docs:build && bun run docs:serve",
    "inspect": "bunx @modelcontextprotocol/inspector",
    "eval:routed-tool-loading": "bun run ./scripts/evaluate/evaluate-routed-tool-loading.ts",
    "verify:template-live": "bun run ./scripts/verify/verify-template-live.ts",
    "verify:uv-density-live": "bun run ./scripts/verify/verify-uv-density-live.ts",
    "audit:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:unused:gateway": "tsc -p gateway/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "verify:texture-runtime-live": "bun run ./scripts/verify/verify-texture-runtime-live.ts",
    "conformance:serve": "bun run ./scripts/operations/serve-conformance-runtime.ts",
    "measure:mcp-efficiency": "bun run ./scripts/measure/measure-mcp-efficiency.ts",
    "measure:describe-payloads": "bun run ./scripts/measure/measure-describe-payloads.ts",
    "benchmark:parametric-authoring": "bun run ./scripts/benchmark/benchmark-parametric-authoring.ts",
    "benchmark:semantic-uv": "bun run ./scripts/benchmark/benchmark-semantic-uv.ts",
    "benchmark:semantic-rig": "bun run ./scripts/benchmark/benchmark-semantic-rig.ts",
    "benchmark:motion-recipe": "bun run ./scripts/benchmark/benchmark-motion-recipe.ts",
    "benchmark:material-recipe": "bun run ./scripts/benchmark/benchmark-material-recipe.ts",
    "benchmark:authoring-orchestration": "bun run ./scripts/benchmark/benchmark-authoring-orchestration.ts",
    "eval:capability-intelligence": "bun run ./scripts/evaluate/evaluate-capability-intelligence.ts && bun run audit:semantic-collisions",
    "test:capability-manifest": "bun test lib/capabilities/manifest.test.ts gateway/capabilities/intelligence.test.ts gateway/capabilities/graph.test.ts gateway/capabilities/manifest.test.ts",
    "test:gateway-structure": "bun test gateway/structure.test.ts gateway/dependencyDirection.test.ts gateway/development/sourceOwners.test.ts gateway/control/referenceParser.test.ts gateway/control/readiness.test.ts gateway/runtime/operationQueue.test.ts gateway/runtime/affinityPolicy.test.ts",
    "test:gateway-recovery": "bun test gateway/index-boundary.test.ts gateway/backend-effects-boundary.test.ts gateway/session/orchestrationRecoveryState.test.ts gateway/runtime/faultInjection.contract.test.ts",
    "eval:decision-efficiency": "bun run ./scripts/evaluate/evaluate-decision-efficiency.ts",
    "analyze:semantic-impact": "bun run ./scripts/development/analyze-semantic-impact.ts",
    "generate:knowledge-index": "bun run ./scripts/development/build-knowledge-index.ts",
    "plan:development-context": "bun run ./scripts/development/plan-development-context.ts",
    "plan:affected": "bun run ./scripts/development/plan-affected-execution.ts",
    "verify:affected": "bun run ./scripts/development/run-affected-execution.ts",
    "verify:semantic-core": "tsc -b tsconfig.semantic-solution.json --pretty false",
    "verify:project-graph": "tsc -b tsconfig.project-graph.json --pretty false",
    "snapshot:semantic-registry": "bun run ./scripts/development/snapshot-semantic-registry.ts",
    "plan:semantic-invalidation": "bun run ./scripts/development/plan-semantic-invalidation.ts",
    "benchmark:semantic-invalidation-scope": "bun run ./scripts/benchmark/benchmark-semantic-invalidation-scope.ts",
    "benchmark:gateway-hot-path": "bun run ./scripts/benchmark/benchmark-gateway-hot-path.ts",
    "benchmark:gateway-replay-shadow": "bun run ./scripts/benchmark/benchmark-gateway-replay-shadow.ts",
    "generate:hybrid4-schemas": "bun run ./scripts/generate/generate-hybrid4-schemas.ts",
    "eval:hybrid-promotion-policy": "bun run ./scripts/evaluate/evaluate-hybrid-promotion-policy.ts",
    "verify:hybrid-remote": "bun run benchmark:gateway-hot-path && bun run benchmark:gateway-replay-shadow && bun run eval:hybrid-promotion-policy && bun test tests/benchmark/gateway-hot-path-strategy-benchmark.test.ts tests/benchmark/gateway-replay-shadow-benchmark.test.ts tests/benchmark/hybrid-promotion-policy.test.ts tests/benchmark/hybrid4-generated-schema.test.ts tests/benchmark/hybrid4-precondition-safety.test.ts",
    "verify:types": "bun run verify:project-graph && bun run typecheck && bun run typecheck:gateway && bun run audit:unused && bun run audit:unused:gateway",
    "verify:contracts": "bun run docs:check && bun run test:runtime && bun run verify:authoring && bun test gateway/ lib/capabilities/manifest.test.ts && bun run eval:capability-intelligence && bun run eval:decision-efficiency",
    "verify:benchmarks": "bun run benchmark:zero-waste-total && bun run benchmark:parametric-authoring && bun run benchmark:semantic-uv && bun run benchmark:semantic-rig && bun run benchmark:motion-recipe && bun run benchmark:material-recipe && bun run benchmark:authoring-orchestration && bun run benchmark:semantic-invalidation-scope && bun run eval:golden-authoring",
    "verify:surface-guards": "bun run measure:surface && bun run measure:stages",
    "eval:golden-authoring": "bun test tests/benchmark/golden-authoring-run-contract.test.ts tests/benchmark/gateway-benchmark-trace-report.test.ts tests/benchmark/golden-benchmark-session-runner.test.ts tests/benchmark/golden-session-finalizer.test.ts tests/benchmark/golden-session-comparison.test.ts gateway/execution/benchmarkTrace.test.ts",
    "report:golden-authoring": "bun run ./scripts/reporting/evaluate-golden-authoring-runs.ts",
    "report:gateway-trace": "bun run ./scripts/reporting/summarize-gateway-benchmark-trace.ts",
    "benchmark:golden-session": "bun run ./scripts/reporting/run-golden-benchmark-session.ts",
    "finalize:golden-session": "bun run ./scripts/reporting/finalize-golden-session.ts",
    "compare:golden-sessions": "bun run ./scripts/reporting/compare-golden-sessions.ts",
    "security:audit": "bun audit --audit-level=high",
    "audit:semantic-collisions": "bun run ./scripts/audit/audit-capability-collisions.ts",
    "audit:data": "bun run ./scripts/development/audit-data-inventory.ts",
    "audit:tests": "bun run ./scripts/development/audit-test-inventory.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "blockbench-types": "5.2.0",
    "tinycolor2": "^1.6.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "electron": "41.10.7",
    "postcss": "8.5.28",
    "nanoid": "3.3.19"
  }
}
